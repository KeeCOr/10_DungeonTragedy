{
  "name": "dragon-tactics",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test --test-reporter=spec tests/**/*.test.js tests/**/*.test.cjs",
    "start": "node server.js",
    "serve": "node server.js",
    "package": "electron-builder --win portable --config.win.signAndEditExecutable=false",
    "electron": "electron .",
    "electron:build": "electron-builder --config.win.signAndEditExecutable=false",
    "build:steam": "electron-builder --config.win.signAndEditExecutable=false",
    "dist:steam": "electron-builder --config.win.signAndEditExecutable=false"
  },
  "build": {
    "appId": "com.stoic.dragontactics",
    "productName": "Dragon Tactics",
    "directories": { "output": "release" },
    "files": ["assets/**/*", "css/**/*", "js/**/*", "index.html", "electron/**/*", "steam_appid.txt"],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }, { "target": "nsis", "arch": ["x64"] }] },
    "portable": { "artifactName": "DragonTactics_v${version}_portable.exe" },
    "nsis": { "oneClick": false, "allowDirChange": true, "shortcutName": "Dragon Tactics", "createDesktopShortcut": true, "createStartMenuShortcut": true }
  },
  "optionalDependencies": { "steamworks.js": "^0.3.1" },
  "devDependencies": { "electron": "^41.2.2", "electron-builder": "^26.8.1" }
}
